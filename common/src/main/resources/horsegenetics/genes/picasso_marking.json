  ],
  "expressions": [
    {
      "id": "marked",
      "name": "Picasso Marking",
      "description": "Two colours the horse draws for itself, and they are drawn separately: the dots first, then the squiggles with a slightly larger copy of the dot field subtracted out of them. That clearance is the whole trick - without it the lines run over the dots and the pattern reads as noise. The dot field is mirrored, so the two sides of the horse match.",
      "when": {
        "Pic": 2
      },
      "layers": [
        {
          "name": "flat dots scattered over the barrel",
          "masks": [
            {
              "type": "SPOTS",
              "parts": [
                "BODY",
                "NECK"
              ],
              "seed": "$seed",
              "spacing": "$dotSpacing",
              "radius": "$dotRadius",
              "vary": 0.4,
              "mirror": true,
              "softness": 0.12
            }
          ],
          "op": {
            "type": "FLAT",
            "hue": "$dotHue",
            "saturation": 0.95,
            "lightness": 0.55
          }
        },
        {
          "name": "squiggles wandering between them",
          "masks": [
            {
              "type": "STROKES",
              "parts": [
                "BODY",
                "NECK"
              ],
              "seed": "$seed",
              "spacing": 5.5,
              "length": 9.0,
              "axis": "X",
              "width": 0.8,
              "curl": 0.85,
              "softness": 0.15
            },
            {
              "type": "SPOTS",
              "parts": [
                "BODY",
                "NECK"
              ],
              "seed": "$seed",
              "spacing": "$dotSpacing",
              "radius": "$dotClearance",
              "vary": 0.4,
              "mirror": true,
              "softness": 0.12,
              "invert": true,
              "combine": "MULTIPLY"
            }
          ],
          "op": {
            "type": "FLAT",
            "hue": "$squiggleHue",
            "saturation": 0.7,
            "lightness": 0.45
          }
        }
      ]
