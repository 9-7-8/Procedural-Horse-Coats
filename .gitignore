# --- Gradle / build output ---
build/
.gradle/
!gradle/wrapper/gradle-wrapper.jar

# --- IDE ---
.idea/
*.iml
*.ipr
*.iws
.vscode/

# --- Minecraft dev run directory ---
# Everything the game writes at runtime: world save states, logs, crash
# reports, screenshots, caches, server op/ban/whitelist lists, options.txt.
# None of it is source; a wiped run/ is rebuilt on the next runClient.
**/run/*

# ...except run/config/fml.toml. It carries earlyWindowControl = false, which
# was the old dev laptop's launch fix (FML's early splash hard-crashed the JVM
# in that machine's AMD GL driver). The current desktop does not need it and it
# is harmless there, so it stays tracked rather than being flipped back - see
# wiki/architecture.html#running.
!**/run/config/
**/run/config/*
!**/run/config/fml.toml

# World save states, wherever they land. Dev test worlds from the "Spawn Test
# Horse World" button are also deleted on shutdown by
# client/DebugTestWorldCleanup; this is the belt-and-braces for a hard kill.
saves/

# --- Java / JVM crash droppings ---
hs_err_pid*.log
replay_pid*.log
*.hprof

# --- OS noise ---
.DS_Store
Thumbs.db
desktop.ini

# TeaVM output - generated by :web:generateWasmGC / :web:generateJavaScript
web/build/

# --- Dedicated server: never in this repo ---
# The test server lives OUTSIDE the working tree (its own directory beside it),
# because it runs a *release* jar and a `git clean` here would eat it. These
# patterns are the safety net for an installer pointed at the wrong folder, and
# for anything carrying a real address.
#
# The tailnet address of the machine is NOT written down anywhere in this repo,
# on purpose. It is a private address on the owner's tailnet; describe it as
# "the server's tailnet address" in the wiki and leave the number out.
libraries/
user_jvm_args.txt
/run.bat
/run.sh
eula.txt
server.properties
ops.json
whitelist.json
banned-ips.json
banned-players.json
usercache.json

# The headless gametest run has its own game directory (see build.gradle).
neoforge-26.1.2/run-gametest/

# --- intake/: third-party pack that may not be redistributed ---
# The Raven icons (licence forbids distributing the pack). The owner keeps them on
# the host machine by hand; the notes beside them stay tracked. See
# intake/potential-assets/raven-fantasy-hd-free/MANIFEST.txt.
intake/potential-assets/raven-fantasy-hd-free/*
!intake/potential-assets/raven-fantasy-hd-free/SOURCE-AND-LICENSE.txt
!intake/potential-assets/raven-fantasy-hd-free/MANIFEST.txt
!intake/potential-assets/raven-fantasy-hd-free/USAGE.txt
!intake/potential-assets/raven-fantasy-hd-free/Clockwork_Raven_General_Licence_v.1.2.pdf
# Pixelated Pattern Textures: licence unknown, so images stay out of git until confirmed.
intake/potential-assets/pixelated-patterns/*
!intake/potential-assets/pixelated-patterns/SOURCE-AND-LICENSE.txt
!intake/potential-assets/pixelated-patterns/USAGE.txt
# The Internet Pattern Book: Geocities tiles the uploader does not own and does not
# license. The owner took them anyway with her eyes open (the reasoning is in the
# notes); they never go in git and are never republished whole.
intake/potential-assets/internet-pattern-book/*
!intake/potential-assets/internet-pattern-book/SOURCE-AND-LICENSE.txt
!intake/potential-assets/internet-pattern-book/USAGE.txt

# Python leaves these beside intake/tools/*.py; they are not source.
__pycache__/
