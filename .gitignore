# --- Gradle / build output ---
build/
.gradle/
!gradle/wrapper/gradle-wrapper.jar

# --- IDE ---
.idea/
*.iml
*.ipr
*.iws
.vscode/

# --- Minecraft dev run directory ---
# Everything the game writes at runtime: world save states, logs, crash
# reports, screenshots, caches, server op/ban/whitelist lists, options.txt.
# None of it is source; a wiped run/ is rebuilt on the next runClient.
**/run/*

# ...except run/config/fml.toml. It carries earlyWindowControl = false, which
# was the old dev laptop's launch fix (FML's early splash hard-crashed the JVM
# in that machine's AMD GL driver). The current desktop does not need it and it
# is harmless there, so it stays tracked rather than being flipped back - see
# wiki/architecture.html#running.
!**/run/config/
**/run/config/*
!**/run/config/fml.toml

# World save states, wherever they land. Dev test worlds from the "Spawn Test
# Horse World" button are also deleted on shutdown by
# client/DebugTestWorldCleanup; this is the belt-and-braces for a hard kill.
saves/

# --- Java / JVM crash droppings ---
hs_err_pid*.log
replay_pid*.log
*.hprof

# --- OS noise ---
.DS_Store
Thumbs.db
desktop.ini

# TeaVM output - generated by :web:generateWasmGC / :web:generateJavaScript
web/build/

# --- Dedicated server: never in this repo ---
# The test server lives OUTSIDE the working tree (its own directory beside it),
# because it runs a *release* jar and a `git clean` here would eat it. These
# patterns are the safety net for an installer pointed at the wrong folder, and
# for anything carrying a real address.
#
# The tailnet address of the machine is NOT written down anywhere in this repo,
# on purpose. It is a private address on the owner's tailnet; describe it as
# "the server's tailnet address" in the wiki and leave the number out.
libraries/
user_jvm_args.txt
/run.bat
/run.sh
eula.txt
server.properties
ops.json
whitelist.json
banned-ips.json
banned-players.json
usercache.json
