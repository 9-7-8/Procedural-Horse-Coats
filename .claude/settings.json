{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-process-kill.mjs\"",
            "shell": "bash",
            "timeout": 10,
            "statusMessage": "Checking for process kills"
          }
        ]
      }
    ]
  }
}
